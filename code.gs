/**
 * Gera o Google Docs, coloca na pasta definida e devolve o link.
 */
function gerarTermo(dados) {
  if (!dados) {
    throw new Error('Nenhum dado foi recebido.');
  }

  const obrigatorios = [
    'razaoSocial',
    'cnpjConcedente',
    'enderecoConcedente',
    'nome',
    'rg',
    'cpf',
    'dataNascimento',
    'enderecoEstagiario',
    'email',
    'dataInicio',
    'dataFim',
    'horarioInicio',
    'horarioFim',
    'horasSemanais',
    'atividades'
  ];

  obrigatorios.forEach(function(campo) {
    if (!dados[campo] || String(dados[campo]).trim() === '') {
      throw new Error('Preencha o campo obrigatório: ' + campo);
    }
  });

  if (String(dados.dataInicio) > String(dados.dataFim)) {
    throw new Error('A data de término não pode ser anterior à data de início.');
  }

  if (dados.maiorDeIdade === 'nao' && !String(dados.responsavelNome || '').trim()) {
    throw new Error('Preencha o nome do responsável ou assistente legal.');
  }

  const nome = String(dados.nome).trim();
  const hoje = new Date();

  const dataArquivo = Utilities.formatDate(
    hoje,
    Session.getScriptTimeZone(),
    'yyyy-MM-dd'
  );

  const nomeArquivo = 'Termo - ' + nome + ' - ' + dataArquivo;

  const documento = DocumentApp.create(nomeArquivo);
  const body = documento.getBody();

  body.clear();
  body.setMarginTop(45);
  body.setMarginBottom(45);
  body.setMarginLeft(45);
  body.setMarginRight(45);

  criarCabecalho(documento);

  const titulo = body.appendParagraph('TERMO DE COMPROMISSO DE ESTÁGIO');
  titulo.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  titulo.editAsText().setBold(true).setFontSize(14);

  const introducao = body.appendParagraph(
    'As partes abaixo qualificadas celebram entre si este TERMO DE COMPROMISSO DE ESTÁGIO, nos termos da Lei nº 11.788, de 25 de setembro de 2008, Lei nº 9.394, de 20 de dezembro de 1996 e demais disposições aplicáveis, mediante as seguintes cláusulas e condições:'
  );
  introducao.setAlignment(DocumentApp.HorizontalAlignment.JUSTIFY);
  introducao.editAsText().setFontSize(10);

  criarSecaoIFRS(body);
  criarSecaoConcedente(body, dados);
  criarSecaoEstagiario(body, dados);
  criarClausulaPrimeira(body, dados);

  adicionarTitulo(body, 'ATIVIDADES A SEREM DESENVOLVIDAS');
  adicionarCaixaTexto(body, valor(dados.atividades));

  criarClausulas(body);

  body.appendParagraph('');
  const cidadeData = body.appendParagraph(
    'ALVORADA, ' + formatarData(dados.dataInicio) + '.'
  );
  cidadeData.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  cidadeData.editAsText().setBold(true).setFontSize(10);

  body.appendParagraph('');
  body.appendParagraph('');
  criarAssinaturas(body, dados);

  criarRodape(documento);

  documento.saveAndClose();

  const pasta = DriveApp.getFolderById(PASTA_DRIVE_ID);
  const arquivo = DriveApp.getFileById(documento.getId());

  pasta.addFile(arquivo);

  try {
    DriveApp.getRootFolder().removeFile(arquivo);
  } catch (e) {
    // Não impede a geração.
  }

  return {
    sucesso: true,
    nomeArquivo: nomeArquivo,
    url: documento.getUrl(),
    id: documento.getId()
  };
}


/**
 * Converte a logo embutida no código para Blob.
 */
function obterLogoBlob() {
  const bytes = Utilities.base64Decode(LOGO_BASE64);
  return Utilities.newBlob(bytes, 'image/png', 'logo-ifrs-campus-alvorada.png');
}


/**
 * Coloca a logo no cabeçalho do Google Docs.
 */
function criarCabecalho(documento) {
  const header = documento.addHeader();
  const p = header.getParagraphs()[0];

  p.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

  const imagem = p.appendInlineImage(obterLogoBlob());
  imagem.setWidth(500);

  imagem.setHeight(142);
  p.appendText('\n');
  p.appendText('________________________________________________________________________________');
  p.editAsText().setFontSize(6);
}


