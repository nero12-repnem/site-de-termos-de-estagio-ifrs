function adicionarTitulo(body, texto) {
  const p = body.appendParagraph(texto);
  p.editAsText().setBold(true).setFontSize(10);
}


function adicionarParagrafo(body, texto) {
  const p = body.appendParagraph(texto);
  p.editAsText().setFontSize(10);
  p.setAlignment(DocumentApp.HorizontalAlignment.JUSTIFY);
}


function adicionarCaixaTexto(body, texto) {
  const tabela = body.appendTable([[texto]]);
  tabela.setBorderWidth(1);
  tabela.setBorderColor('#000000');

  tabela
    .getCell(0, 0)
    .getChild(0)
    .asParagraph()
    .editAsText()
    .setFontSize(9);

  body.appendParagraph('');
}


function valor(v) {
  if (v === undefined || v === null || String(v).trim() === '') {
    return '-';
  }

  return String(v).trim();
}


function formatarData(data) {
  if (!data) {
    return '-';
  }

  const partes = String(data).split('-');

  if (partes.length !== 3) {
    return data;
  }

  return partes[2] + '/' + partes[1] + '/' + partes[0];
}
function listarVagas() {

  const planilha = SpreadsheetApp.openById(
    PLANILHA_VAGAS_ID
  );

  const aba = planilha.getSheetByName(
    ABA_VAGAS
  );

  if (!aba) {
    throw new Error(
      'A aba "' + ABA_VAGAS + '" não foi encontrada.'
    );
  }

  const valores =
    aba.getDataRange().getDisplayValues();

  if (valores.length < 2) {
    return [];
  }

  const cabecalhos = valores[0];

  const vagas = [];

  for (let i = 1; i < valores.length; i++) {

    const linha = valores[i];

    if (linha.join('').trim() === '') {
      continue;
    }

    const vaga = {};

    cabecalhos.forEach(function(cabecalho, indice) {
      vaga[cabecalho] = linha[indice] || '';
    });

    if (
      String(vaga.Status)
        .trim()
        .toUpperCase() !== 'ATIVA'
    ) {
      continue;
    }

    vagas.push({
      id: vaga.ID,
      empresa: vaga.Empresa,
      cnpj: vaga.CNPJ,
      ramo: vaga.Ramo,
      endereco: vaga.Endereco,
      telefone: vaga.Telefone,
      emailEmpresa: vaga.EmailEmpresa,
      representante: vaga.Representante,
      cargoRepresentante: vaga.CargoRepresentante,
      supervisor: vaga.Supervisor,
      cargoSupervisor: vaga.CargoSupervisor,
      formacaoSupervisor: vaga.FormacaoSupervisor,
      telefoneSupervisor: vaga.TelefoneSupervisor,
      emailSupervisor: vaga.EmailSupervisor,
      titulo: vaga.TituloVaga,
      curso: vaga.Curso,
      cidade: vaga.Cidade,
      modalidade: vaga.Modalidade,
      cargaHoraria: vaga.CargaHoraria,
      bolsa: vaga.Bolsa,
      beneficios: vaga.Beneficios,
      requisitos: vaga.Requisitos,
      descricao: vaga.Descricao,
      prazo: vaga.Prazo,
      dataInicio: vaga.DataInicio,
      dataFim: vaga.DataFim,
      horarioInicio: vaga.HorarioInicio,
      horarioFim: vaga.HorarioFim
    });
  }

  return vagas;
}
