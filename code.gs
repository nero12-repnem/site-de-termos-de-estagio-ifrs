/**
 * Caixa com moldura para as seções.
 */
function criarCaixaDados(body, titulo, dados) {
  const tabela = body.appendTable();
  tabela.setBorderWidth(1);
  tabela.setBorderColor('#000000');

  const linhaTitulo = tabela.appendTableRow();
  const celulaTitulo = linhaTitulo.appendTableCell(titulo);
  celulaTitulo.setBackgroundColor('#EDEDED');

  celulaTitulo
    .getChild(0)
    .asParagraph()
    .editAsText()
    .setBold(true)
    .setFontSize(10);

  dados.forEach(function(item) {
    const linha = tabela.appendTableRow();

    const campo = linha.appendTableCell(String(item[0]));
    const valorCampo = linha.appendTableCell(String(item[1]));

    campo.setBackgroundColor('#F5F5F5');

    campo
      .getChild(0)
      .asParagraph()
      .editAsText()
      .setBold(true)
      .setFontSize(9);

    valorCampo
      .getChild(0)
      .asParagraph()
      .editAsText()
      .setFontSize(9);
  });

  body.appendParagraph('');
}


